// ==========================================
// 1.  GENERATOR & DATASOURCE
// ==========================================
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 2.  ENUMS
// ==========================================
enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum EmailStatus {
  PENDING
  VERIFIED
  BOUNCED
}

enum AccountStatus {
  ACTIVE
  /// Read-only until suspendedUntil. See docs/MODERATION.md.
  SUSPENDED
  /// Signed in only to see why, appeal, or delete the account.
  BANNED
  DELETED
}

// ==========================================
// 3.  CORE USER
// ==========================================
model User {
  id       String        @id @default(uuid()) @db.Uuid
  email    String        @unique
  username String?       @unique
  // Nullable: accounts provisioned from a Supabase access token have no local
  // password. Supabase holds the credential; this row only mirrors the identity
  // so the relations below still have something to hang off.
  password String?
  name     String?
  role     UserRole      @default(USER)
  status   AccountStatus @default(ACTIVE)

  // 🔥 NEW: DID & Kyron Points
  did         String? @unique
  kyronPoints Int     @default(0)

  // Email verification
  emailStatus     EmailStatus @default(PENDING)
  emailVerifiedAt DateTime?

  // Security
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  // Notifications are derived from the likes, comments, reposts and follows
  // themselves, so there is no per-row read state to keep. This one watermark
  // is what makes them unread: anything after it has not been looked at.
  notificationsSeenAt DateTime? @db.Timestamptz()

  // Whether the people this account writes to are told it has read their
  // messages -- and, both ways, whether it is told when they have read its.
  // A trade, as every messenger that offers it makes it: off for one side
  // means neither sees "Seen".
  readReceipts Boolean @default(true)

  // Whether the people this account talks to see a green dot while it has
  // the app open. The same trade as read receipts: off means this account
  // sees nobody's either, so it cannot watch for others without being seen.
  showOnline Boolean @default(true)

  // Whether posts from this account's communities also appear in Home. Off,
  // they stay in Communities, where each one shows what is new.
  communityPostsInHome Boolean @default(true)

  // When a suspension ends. Kept in step with status by
  // ModerationService.applyStanding from the actions that are in force, so
  // the guard can tell a running suspension from a finished one without a
  // second query.
  suspendedUntil DateTime? @db.Timestamptz()

  // Set while the account carries the verified badge: somebody on the team
  // checked it is who it says it is. Null otherwise. See docs/VERIFICATION.md.
  verifiedAt DateTime? @db.Timestamptz()

  // Timestamps
  createdAt DateTime  @default(now()) @db.Timestamptz()
  updatedAt DateTime  @updatedAt @db.Timestamptz()
  deletedAt DateTime? @db.Timestamptz()

  // Relations
  profile               UserProfile?
  emailVerification     EmailVerification?
  sessions              UserSession[]
  refreshTokens         RefreshToken[]
  passwordResets        PasswordReset[]
  auditLogs             AuditLog[]
  interests             UserInterest[]
  conversations         ConversationMember[]
  messagesSent          Message[]
  communities           CommunityMember[]
  communityBans         CommunityBan[]        @relation("CommunityBanned")
  communityBansMade     CommunityBan[]        @relation("CommunityBanner")
  posts                 Post[]
  // These two read backwards from their relation names, so they are spelled
  // out. `Follow.follower` holds followerId, so its back-reference is the set
  // of follows this account *made* -- the people it follows. Named the other
  // way round, `_count.followers` silently returned the following count.
  following             Follow[]              @relation("follower")
  followers             Follow[]              @relation("following")
  likes                 PostLike[]
  commentLikes          CommentLike[]
  saves                 PostSave[]
  comments              Comment[]
  views                 PostView[]
  reposts               Repost[]
  hiddenPosts           HiddenPost[]
  mutes                 Mute[]                @relation("MuteOwner")
  mutedBy               Mute[]                @relation("MuteTarget")
  blocking              Block[]               @relation("Blocker")
  blockedBy             Block[]               @relation("Blocked")
  reportsMade           Report[]              @relation("Reporter")
  interestSignals       InterestSignal[]
  pollVotes             PollVote[]
  kyronPointEvents      KyronPointEvent[] // 🔥 NEW
  devices               DeviceToken[]
  messageKeys           MessageKey[]
  messageKeyShares      MessageKeyShare[]
  feedback              Feedback[]
  messageReactions      MessageReaction[]
  moderationActions     ModerationAction[]    @relation("ModerationSubject")
  moderationTaken       ModerationAction[]    @relation("ModerationModerator")
  moderationUndone      ModerationAction[]    @relation("ModerationReverser")
  appeals               Appeal[]              @relation("AppealAuthor")
  appealsDecided        Appeal[]              @relation("AppealReviewer")
  reportsResolved       Report[]              @relation("ReportResolver")
  verificationRequests  VerificationRequest[] @relation("VerificationApplicant")
  verificationsReviewed VerificationRequest[] @relation("VerificationReviewer")

  @@index([email])
  @@index([status])
  @@index([username])
  @@index([did]) // 🔥 NEW
}

// ==========================================
// 4.  USER PROFILE
// ==========================================
model UserProfile {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @db.Uuid
  avatarUrl   String?
  coverUrl    String?
  bio         String?
  location    String?
  website     String?
  dateOfBirth DateTime? @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
}

// ==========================================
// 4b. POSTS
// ==========================================
// The feed used to live in a private array on FeedService: unauthenticated,
// with the author taken from the request body, and emptied on every restart.
// Render restarts the service when it goes idle, so in practice it was always
// empty and the client rendered placeholders instead.
model Post {
  id       String @id @default(uuid()) @db.Uuid
  authorId String @db.Uuid
  content  String @db.Text

  // Soft delete: a removed post still has to hold its place in a cursor, and
  // deleting the row outright would silently shift every page after it.
  deletedAt DateTime? @db.Timestamptz()
  createdAt DateTime  @default(now()) @db.Timestamptz()
  updatedAt DateTime  @updatedAt @db.Timestamptz()

  // Who may reply. The composer offers this and the server enforces it; a
  // setting the client shows and the server ignores is not a setting.
  replyPolicy ReplyPolicy @default(EVERYONE)

  // Set when this post quotes another. A repost without a quote is a Repost
  // row instead -- it has no content of its own to store.
  quotedPostId String? @db.Uuid

  /// Engagement, counted here rather than aggregated per read.
  ///
  /// Prisma compiles a relation `_count` into a LEFT JOIN over an *unfiltered*
  /// `GROUP BY postId` across the whole table -- so the cost is the size of
  /// PostLike, not the size of the page. Fetching twenty posts that way took
  /// 13.5ms against 0.46ms for the same twenty reading columns, and it would
  /// have grown with every like ever recorded. Maintained on the write paths
  /// in FeedService, and recomputable with scripts/recount.sql.
  ///
  /// commentCount counts what the thread actually shows: a soft-deleted
  /// comment is not in the list, so it is not in the number either. The
  /// `_count` this replaces included them, which is why a post could say five
  /// and show four.
  likeCount    Int @default(0)
  commentCount Int @default(0)
  repostCount  Int @default(0)

  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  likes    PostLike[]
  saves    PostSave[]
  comments Comment[]
  views    PostView[]
  media    Media[]
  reposts  Repost[]
  hashtags PostHashtag[]
  topics   PostTopic[]

  // Set when the post was written into a community rather than the feed.
  // Nullable, because most posts are not.
  communityId String?          @db.Uuid
  community   Community?       @relation(fields: [communityId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  hidden      HiddenPost[]
  mutes       Mute[]
  signals     InterestSignal[]
  poll        Poll?

  // SetNull, not Cascade: deleting a quoted post should not delete everyone's
  // commentary on it. The client renders the gap.
  quotedPost Post?  @relation("PostQuotes", fields: [quotedPostId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  quotedBy   Post[] @relation("PostQuotes")

  @@index([authorId])
  @@index([communityId])
  // The newest post in each community, and how many came after a member last
  // looked: what every row of the Communities list is made of.
  @@index([communityId, createdAt(sort: Desc)])
  // The feed's only ordering. id breaks ties so a cursor is stable when two
  // posts share a timestamp, which is common when seeding or importing.
  @@index([createdAt(sort: Desc), id(sort: Desc)])
}

// ==========================================
// 5.  EMAIL VERIFICATION
// ==========================================
model EmailVerification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  code      String
  expiresAt DateTime @db.Timestamptz()
  createdAt DateTime @default(now()) @db.Timestamptz()
  attempts  Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

// ==========================================
// 6.  SESSIONS
// ==========================================
model UserSession {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  token        String   @unique
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now()) @db.Timestamptz()
  expiresAt    DateTime @db.Timestamptz()
  lastActivity DateTime @default(now()) @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, expiresAt])
}

// ==========================================
// 7.  REFRESH TOKENS
// ==========================================
model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime @db.Timestamptz()
  createdAt DateTime @default(now()) @db.Timestamptz()
  sessionId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, expiresAt])
}

// ==========================================
// 8.  PASSWORD RESETS
// ==========================================
model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @db.Uuid
  token     String    @unique
  expiresAt DateTime  @db.Timestamptz()
  createdAt DateTime  @default(now()) @db.Timestamptz()
  usedAt    DateTime? @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

// ==========================================
// 9.  AUDIT LOG
// ==========================================
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  ipAddress String?
  userAgent String?
  details   Json?
  createdAt DateTime @default(now()) @db.Timestamptz()

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId, createdAt])
  @@index([action])
}

// ==========================================
// 10.  INTERESTS
// ==========================================
model Interest {
  id    String         @id @default(uuid()) @db.Uuid
  slug  String         @unique
  name  String
  users UserInterest[]
  posts PostTopic[]

  @@index([slug])
}

// A topic the author filed a post under.
//
// Separate from PostHashtag because the two are different things. A hashtag is
// whatever somebody typed; a topic is one of a fixed set, chosen deliberately,
// and the same set people pick from when they say what they are into. Before
// this, a topic could only be shown as "what the people who follow it are
// posting", which is a guess about the author rather than a fact about the
// post.
model PostTopic {
  postId     String @db.Uuid
  interestId String @db.Uuid

  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([postId, interestId])
  @@index([interestId])
}

model UserInterest {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  interestId String @db.Uuid

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, interestId])
  @@index([userId])
  @@index([interestId])
}

// ==========================================
// 11.  FOLLOW (future-proof)
// ==========================================
model Follow {
  id          String   @id @default(uuid()) @db.Uuid
  followerId  String   @db.Uuid
  followingId String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz()

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// ==========================================
// 11b. LIKES AND SAVES
// ==========================================
// The drawer offered "Saved Posts" and the profile screen counted likes, with
// nothing behind either: no table, no endpoint. Both were rendered from a
// hard-coded number. These are the rows those screens read.
//
// Separate tables rather than one with a `kind` column: a like is public and
// counted on the post, a save is private to the person who made it, and
// keeping them apart means a query for one cannot accidentally leak the other.
// A like on a comment. The same shape as PostLike, and separate for the same
// reason the tables are: a comment is not a post, and a single polymorphic
// "like" table would need a check constraint to stop a row pointing at both.
model CommentLike {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  commentId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz()

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // One like per person per comment. Without it a double tap counts twice.
  @@unique([userId, commentId])
  @@index([commentId])
}

model PostLike {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  postId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // One like per person per post. Without it a double tap counts twice.
  @@unique([userId, postId])
  @@index([postId])
  // The "liked posts" list, newest first, is read straight off this.
  @@index([userId, createdAt(sort: Desc)])
}

model PostSave {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  postId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId, createdAt(sort: Desc)])
}

// ==========================================
// 11c. COMMENTS
// ==========================================
// Self-referencing, so a reply is a comment with a parent rather than a second
// table. One level is what the screen renders: a reply to a reply is attached
// to the same thread, because a tree deeper than that does not fit on a phone
// and every client ends up flattening it anyway.
model Comment {
  id       String  @id @default(uuid()) @db.Uuid
  postId   String  @db.Uuid
  authorId String  @db.Uuid
  parentId String? @db.Uuid
  content  String  @db.Text

  // Soft delete, for the same reason posts have one: a removed comment still
  // holds its place in a cursor, and its replies still need a parent to hang
  // off.
  deletedAt DateTime? @db.Timestamptz()
  createdAt DateTime  @default(now()) @db.Timestamptz()
  updatedAt DateTime  @updatedAt @db.Timestamptz()

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  author  User          @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  parent  Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  replies Comment[]     @relation("CommentReplies")
  media   Media[]
  likes   CommentLike[]

  @@index([authorId])
  // A post's top-level comments, oldest first -- the order a thread reads in.
  @@index([postId, parentId, createdAt])
  @@index([parentId, createdAt])
}

// ==========================================
// 11d. POST VIEWS
// ==========================================
// One row per person per post, not per open: an impression counter that counts
// the same person twice tells an author nothing, and refreshing would inflate
// it without limit.
model PostView {
  id       String @id @default(uuid()) @db.Uuid
  postId   String @db.Uuid
  viewerId String @db.Uuid

  /// How many times this reader has opened it. One row per person still --
  /// the count is what tells a first look apart from a fourth, which is the
  /// difference between "they have seen it" and "stop showing them this".
  count Int @default(1)

  /// How long they spent on it in total, in milliseconds. Reported by the
  /// client when the post leaves the screen, and clamped server side: it is a
  /// number a phone can make up.
  dwellMs Int @default(0)

  createdAt    DateTime @default(now()) @db.Timestamptz()
  lastViewedAt DateTime @default(now()) @db.Timestamptz()

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  viewer User @relation(fields: [viewerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([postId, viewerId])
  @@index([postId, createdAt])
  @@index([viewerId, lastViewedAt])
}

// ==========================================
// 11e. MEDIA
// ==========================================
enum MediaKind {
  IMAGE
  VIDEO
  GIF
  /// A voice recording made in the composer.
  VOICE
}

enum ReplyPolicy {
  EVERYONE
  FOLLOWERS
  MENTIONED
  NOBODY
}

// One table for both, with exactly one of postId/commentId set. Two tables
// would duplicate every column and every upload path for no gain: a picture
// attached to a reply is the same picture attached to a post.
model Media {
  id        String    @id @default(uuid()) @db.Uuid
  postId    String?   @db.Uuid
  commentId String?   @db.Uuid
  messageId String?   @db.Uuid
  kind      MediaKind @default(IMAGE)
  url       String

  // Stored so a list can reserve the right space before the bytes arrive.
  // Without them every image pops the layout as it loads.
  width  Int?
  height Int?

  /// Author-supplied description, for anyone using a screen reader.
  alt String?

  /// How long a voice recording runs, in milliseconds. Null for everything
  /// else -- a still has no duration, and a video's is read from the file.
  durationMs Int?

  /// The recording's loudness over time, 0-100, one value per bar of the
  /// waveform. Sampled on the device while recording, because that is the only
  /// place the signal exists: deriving it on the server would mean decoding
  /// every upload to draw a picture of it.
  ///
  /// Stored as ints rather than a blob so it can be read back without a
  /// decoding step, and capped by the client at a bar count that fits a phone.
  waveform Int[]

  /// A still from a video, uploaded alongside it by the composer.
  ///
  /// Stored so a list can draw a clip without opening a decoder for it. A
  /// phone has a hard ceiling on how many videos it can decode at once --
  /// exceeding it fails the surface and the tile goes black -- so a wall of
  /// clips has to be a wall of pictures with one player over the top.
  ///
  /// Null for anything that is not a video, and for videos posted before the
  /// composer started sending one.
  thumbnailUrl String?

  /// Order within its post or comment, 0 first.
  position Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz()

  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  message Message? @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([postId, position])
  @@index([commentId, position])
  @@index([messageId, position])
}

// ==========================================
// 11f. REPOSTS
// ==========================================
// A plain repost. A quote is a Post with quotedPostId set, because it has
// content of its own; this has none, so a row is the whole record.
model Repost {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  postId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId, createdAt(sort: Desc)])
}

// ==========================================
// 11g. HASHTAGS
// ==========================================
model Hashtag {
  id  String @id @default(uuid()) @db.Uuid
  // Stored lower-cased so #Kyron and #kyron are one tag. The client renders
  // whichever casing the post used.
  tag String @unique

  createdAt DateTime      @default(now()) @db.Timestamptz()
  posts     PostHashtag[]
}

model PostHashtag {
  postId    String @db.Uuid
  hashtagId String @db.Uuid

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  hashtag Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([postId, hashtagId])
  @@index([hashtagId])
}

// ==========================================
// 11h. MODERATION AND FEED CONTROL
// ==========================================
enum MuteKind {
  USER
  WORD
  THREAD
}

enum InterestKind {
  MORE
  LESS
}

enum ReportTarget {
  POST
  COMMENT
  USER
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE
  VIOLENCE
  SELF_HARM
  SEXUAL_CONTENT
  CHILD_SAFETY
  MISINFORMATION
  IMPERSONATION
  INTELLECTUAL_PROPERTY
  ILLEGAL_GOODS
  SOMETHING_ELSE
}

enum ReportStatus {
  RECEIVED
  REVIEWING
  ACTIONED
  DISMISSED
}

// Blocking is mutual in effect: neither account sees the other's posts, and
// neither can follow the other. Enforced in the feed query, not just hidden
// in the client.
model Block {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz()

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// One table for the three kinds of mute, with exactly one target column set.
// They are the same idea -- "do not show me this" -- and one table means the
// feed reads them in one query rather than three.
model Mute {
  id     String   @id @default(uuid()) @db.Uuid
  userId String   @db.Uuid
  kind   MuteKind

  targetUserId String? @db.Uuid
  targetPostId String? @db.Uuid

  /// Lower-cased for WORD mutes. Matched case-insensitively against content.
  phrase String?

  createdAt DateTime @default(now()) @db.Timestamptz()

  user       User  @relation("MuteOwner", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  targetUser User? @relation("MuteTarget", fields: [targetUserId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  targetPost Post? @relation(fields: [targetPostId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, kind, targetUserId, targetPostId, phrase])
  @@index([userId, kind])
}

/// A single post the reader asked not to see again.
model HiddenPost {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  postId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, postId])
  @@index([userId])
}

/// "Show more of this" and "show less of this", recorded against the post that
/// prompted it. Kept even though the feed is chronological today: a signal
/// thrown away is a signal that cannot inform ranking later.
model InterestSignal {
  id     String       @id @default(uuid()) @db.Uuid
  userId String       @db.Uuid
  postId String       @db.Uuid
  kind   InterestKind

  createdAt DateTime @default(now()) @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, postId])
  @@index([userId, kind])
}

model Report {
  id         String       @id @default(uuid()) @db.Uuid
  reporterId String       @db.Uuid
  target     ReportTarget
  targetId   String       @db.Uuid
  reason     ReportReason

  /// What the reporter added in their own words. Optional.
  detail String? @db.Text

  status ReportStatus @default(RECEIVED)

  /// A copy of what was reported, taken at the time. Without it a report is
  /// unreviewable the moment its subject edits or deletes the content.
  snapshot String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  // What came of it. Set together when somebody on the team closes it:
  // dismissed, or acted on through [action].
  resolvedAt   DateTime? @db.Timestamptz()
  resolvedById String?   @db.Uuid
  actionId     String?   @db.Uuid

  reporter   User              @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  resolvedBy User?             @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  action     ModerationAction? @relation(fields: [actionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // One report per person per thing. A second one is the same complaint, and
  // counting it twice would make a brigade look like a consensus.
  @@unique([reporterId, target, targetId])
  @@index([target, targetId])
  @@index([status, createdAt])
  @@index([reporterId, createdAt(sort: Desc)])
}

// ==========================================
// 11z. ENFORCEMENT AND APPEALS
// ==========================================
// See docs/MODERATION.md for the policy these carry out.

/// What the team did about an account.
///
/// The account-level effect is [kind]; content removed as part of the same
/// decision is [target]/[targetId], so "removed the post and suspended the
/// account" is one decision with one notice and one appeal, not two.
enum ModerationKind {
  /// Content removed, nothing else.
  REMOVE
  /// A notice on the record. Nothing is restricted.
  WARN
  /// Read-only until endsAt.
  SUSPEND
  /// Until an appeal or the team reverses it.
  BAN
}

enum AppealStatus {
  OPEN
  /// The decision stands.
  UPHELD
  /// The decision is reversed: content restored, restrictions lifted.
  OVERTURNED
}

model ModerationAction {
  id     String @id @default(uuid()) @db.Uuid
  /// What the account and the team quote: "case 12".
  number Int    @unique @default(autoincrement())

  /// Null once the account is deleted. The record stays, without the
  /// content it quoted: see AccountService.deleteData.
  subjectId   String? @db.Uuid
  /// Null once that moderator's account is deleted.
  moderatorId String? @db.Uuid

  kind ModerationKind
  /// Which rule, in the same words a report uses.
  rule ReportReason

  /// What the account is told, in the moderator's words.
  message String  @db.Text
  /// For the team only. Never sent to the account.
  note    String? @db.Text

  /// The post or comment this decision is about, if it is about one.
  target         ReportTarget?
  targetId       String?       @db.Uuid
  /// Whether this decision took it down. False when its author had already
  /// deleted it, so overturning the decision does not bring back something
  /// its author removed themselves.
  removedContent Boolean       @default(false)
  /// What it said when the decision was made.
  snapshot       String?       @db.Text

  /// When a SUSPEND ends.
  endsAt DateTime? @db.Timestamptz()

  createdAt DateTime  @default(now()) @db.Timestamptz()
  /// When the account first opened the notice.
  seenAt    DateTime? @db.Timestamptz()

  /// Undone: by an appeal, or by the team on its own account of a mistake.
  reversedAt   DateTime? @db.Timestamptz()
  reversedById String?   @db.Uuid
  reversal     String?   @db.Text

  subject    User?    @relation("ModerationSubject", fields: [subjectId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  moderator  User?    @relation("ModerationModerator", fields: [moderatorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reversedBy User?    @relation("ModerationReverser", fields: [reversedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  appeal     Appeal?
  reports    Report[]

  @@index([subjectId, createdAt(sort: Desc)])
  @@index([target, targetId])
}

/// One per decision: asking for it to be looked at again.
model Appeal {
  id        String @id @default(uuid()) @db.Uuid
  actionId  String @unique @db.Uuid
  userId    String @db.Uuid
  /// Why the account thinks the decision was wrong.
  statement String @db.Text

  status     AppealStatus @default(OPEN)
  reviewerId String?      @db.Uuid
  /// What the account is told about the decision.
  response   String?      @db.Text

  createdAt DateTime  @default(now()) @db.Timestamptz()
  decidedAt DateTime? @db.Timestamptz()
  /// When the account first read the decision.
  seenAt    DateTime? @db.Timestamptz()

  action   ModerationAction @relation(fields: [actionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user     User             @relation("AppealAuthor", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reviewer User?            @relation("AppealReviewer", fields: [reviewerId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status, createdAt])
}

/// What an account says it is, when it asks for the badge.
enum VerificationCategory {
  CREATOR
  PUBLIC_FIGURE
  JOURNALIST
  ORGANISATION
  OTHER
}

enum VerificationStatus {
  PENDING
  APPROVED
  DENIED
  /// Taken back by the account before anybody decided.
  WITHDRAWN
}

/// Asking for the verified badge, and the answer.
///
/// Evidence is links, not documents: a site or another profile that says
/// this Kyron account is theirs. Kyron does not take identity documents --
/// keeping them safely is a job of its own, and a link the reviewer can
/// follow is what most verification actually rests on.
model VerificationRequest {
  id       String               @id @default(uuid()) @db.Uuid
  /// What the account quotes: "request 3".
  number   Int                  @unique @default(autoincrement())
  userId   String               @db.Uuid
  category VerificationCategory
  /// Who they are, in their own words.
  about    String               @db.Text
  /// Where the reviewer can check it, one to three links.
  links    String[]

  status     VerificationStatus @default(PENDING)
  reviewerId String?            @db.Uuid
  /// What the account is told: required when it is turned down.
  response   String?            @db.Text

  createdAt DateTime  @default(now()) @db.Timestamptz()
  decidedAt DateTime? @db.Timestamptz()

  user     User  @relation("VerificationApplicant", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reviewer User? @relation("VerificationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt(sort: Desc)])
}

/// An email address that belongs to a banned account, kept as a hash.
///
/// Deleting a banned account removes the account and its address with it,
/// and signing up again with the same address would start clean. A new
/// account whose address hashes to one of these starts banned instead,
/// under the same case, and can appeal it like the first.
model BannedIdentity {
  /// sha256 of the lower-cased, trimmed address.
  emailHash String   @id
  /// The ban it came from. Not a relation: the action can lose its subject,
  /// and this must outlive both.
  actionId  String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz()

  @@index([actionId])
}

// ==========================================
// 12.  KYRON POINTS ENGINE (IMMUTABLE)
// ==========================================
model KyronPointEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  amount    Int
  reason    String
  createdAt DateTime @default(now()) @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

// ==========================================
// 13.  SYSTEM MODULES
// ==========================================
model SystemModule {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz()
  updatedAt   DateTime @updatedAt @db.Timestamptz()
}

// ==========================================
// 14.  APP SETTINGS
// ==========================================
model AppSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       String
  type        String   @default("string")
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz()
  updatedAt   DateTime @updatedAt @db.Timestamptz()
}

// ==========================================
// 15.  LINK PREVIEWS
// ==========================================
// One cached fetch of a URL's Open Graph card, keyed by the URL as it was
// normalised. Cached because a link in a popular post would otherwise be
// fetched once per reader, which is both slow for them and a way to point the
// whole readership at one site at once.
//
// `failedAt` is stored rather than the row simply being absent: a URL that has
// no card, or would not load, must not be re-fetched on every scroll past it.
model LinkPreview {
  id  String @id @default(uuid()) @db.Uuid
  url String @unique

  title       String?
  description String? @db.Text
  imageUrl    String?
  siteName    String?

  /// The host, kept separately so the card can show it without re-parsing.
  host String

  /// Set when the fetch produced no usable card. Retried after a while, since
  /// a site that was down when a post was written may be up when it is read.
  failedAt DateTime? @db.Timestamptz()

  fetchedAt DateTime @default(now()) @db.Timestamptz()

  @@index([fetchedAt])
}

// ==========================================
// 16.  POLLS
// ==========================================
// A poll belongs to exactly one post. Options are rows rather than a JSON
// column so a vote can reference one by id and be counted by the database --
// counting votes by reading and rewriting a JSON array loses concurrent votes.
model Poll {
  id     String @id @default(uuid()) @db.Uuid
  postId String @unique @db.Uuid

  /// When voting closes. Stored as an instant, not a duration, so the closing
  /// time does not move when the row is read.
  closesAt DateTime @db.Timestamptz()

  createdAt DateTime @default(now()) @db.Timestamptz()

  post    Post         @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  options PollOption[]
  votes   PollVote[]
}

model PollOption {
  id     String @id @default(uuid()) @db.Uuid
  pollId String @db.Uuid
  text   String

  /// Order as the author wrote them, 0 first. Without this the options would
  /// come back in whatever order the database found them, which changes
  /// between reads and moves the answers under the reader's finger.
  position Int @default(0)

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  votes PollVote[]

  @@index([pollId, position])
}

model PollVote {
  id       String @id @default(uuid()) @db.Uuid
  pollId   String @db.Uuid
  optionId String @db.Uuid
  userId   String @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz()

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // One vote per person per poll, enforced here rather than in the handler:
  // two taps racing each other both pass a "have you voted?" check.
  @@unique([pollId, userId])
  @@index([optionId])
}

// ==========================================
// 14.  DIRECT MESSAGES
// ==========================================
// Stored on the server in plain text, like the posts are. Worth being explicit
// about: this is not end-to-end encrypted, and anything with the service role
// can read it. What it does guarantee is that nobody else can -- every read
// goes through membership, and a block closes the conversation both ways.
model Conversation {
  id String @id @default(uuid()) @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz()

  // Bumped on every message, because the list is ordered by which
  // conversation moved last and ordering by a subquery over messages would be
  // a sort over the whole table per page.
  lastMessageAt DateTime @default(now()) @db.Timestamptz()

  members  ConversationMember[]
  messages Message[]

  @@index([lastMessageAt(sort: Desc)])
}

model ConversationMember {
  conversationId String @db.Uuid
  userId         String @db.Uuid

  joinedAt DateTime @default(now()) @db.Timestamptz()

  // How far this member has read. Null until they have opened it once, which
  // is not the same as having read nothing: a conversation they started and
  // never came back to should not show its own message as unread.
  lastReadAt DateTime? @db.Timestamptz()

  // Set when this member leaves the thread out of their own list. The rows
  // stay, because the other side's history is the same rows.
  hiddenAt DateTime? @db.Timestamptz()

  // Set when this member wants it quiet. Their own setting: muting is not
  // something the other side should be able to see or undo.
  mutedAt DateTime? @db.Timestamptz()

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String @id @default(uuid()) @db.Uuid
  conversationId String @db.Uuid
  senderId       String @db.Uuid

  body String @db.Text

  /// The message this one answers, if it answers one.
  ///
  /// The id only. A direct message is sealed before it leaves the phone and
  /// this server stores ciphertext it cannot read -- so a reply carrying the
  /// quoted *text* would write that text into the database in the clear, and
  /// undo the encryption for every message anybody ever replied to. The client
  /// holds the thread decrypted already and resolves the quote itself.
  replyToId String? @db.Uuid

  /// The card for the first link in the message, made on the sender's phone
  /// and sealed the way the body is.
  ///
  /// Not fetched by this server, as a post's card is: that would have the
  /// server read the address out of a message it otherwise cannot read. The
  /// sender's phone reads the page, shrinks its picture, and seals the lot;
  /// readers draw it without asking the linked site for anything. Null for a
  /// message with no link, or one whose sender took the card off.
  linkCard String? @db.Text

  createdAt DateTime  @default(now()) @db.Timestamptz()
  // Soft delete, for the same reason posts have one: a removed message still
  // holds its place in a cursor.
  deletedAt DateTime? @db.Timestamptz()

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  media        Media[]

  /// SetNull, not Cascade: deleting the message somebody answered must not
  /// delete their answer. The reply loses its quote and keeps its words.
  replyTo Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  replies Message[] @relation("MessageReplies")

  reactions MessageReaction[]
  keyShares MessageKeyShare[]

  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([replyToId])
}

// ==========================================
// 15.  COMMUNITIES
// ==========================================
enum CommunityRole {
  OWNER
  MODERATOR
  MEMBER
}

model Community {
  id String @id @default(uuid()) @db.Uuid

  // What it is addressed by. Lower-cased on the way in, like a hashtag, so
  // /c/Design and /c/design are the same place.
  slug String @unique

  name        String
  description String? @db.Text
  avatarUrl   String?
  bannerUrl   String?

  createdById String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz()

  // Soft delete, so a post that pointed at it still resolves to something.
  deletedAt DateTime? @db.Timestamptz()

  members CommunityMember[]
  posts   Post[]
  bans    CommunityBan[]

  @@index([slug])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
}

// Somebody removed from a community.
//
// A separate row rather than a flag on the membership, because removing
// deletes the membership: without this, "you are out" and "join again" are the
// same button, and a moderator's decision lasts until the person taps it.
model CommunityBan {
  communityId String   @db.Uuid
  userId      String   @db.Uuid
  bannedById  String   @db.Uuid
  reason      String?  @db.Text
  createdAt   DateTime @default(now()) @db.Timestamptz()

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user      User      @relation("CommunityBanned", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  bannedBy  User      @relation("CommunityBanner", fields: [bannedById], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([communityId, userId])
  @@index([userId])
}

model CommunityMember {
  communityId String        @db.Uuid
  userId      String        @db.Uuid
  role        CommunityRole @default(MEMBER)
  joinedAt    DateTime      @default(now()) @db.Timestamptz()

  // When this member last opened the community. Posts by other people after
  // it are what the Communities list counts as new; null means never opened
  // since this was added, and joinedAt stands in for it.
  lastReadAt DateTime? @db.Timestamptz()

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([communityId, userId])
  @@index([userId])
}

/// Where to push a notification for one person.
///
/// One row per install, not per account: the same phone signed into a second
/// account gets a new token from the platform, and a token that outlives a
/// sign-out would deliver somebody else's messages to whoever holds the
/// handset now. Deleted on sign-out, and on the first send that the platform
/// says the token is dead.
model DeviceToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The registration token the platform issued. Unique across everybody:
  /// a handset that changes hands must not end up in two accounts at once.
  token String @unique

  /// ios, android or web. Kept so a send can be shaped per platform later.
  platform String

  createdAt DateTime @default(now()) @db.Timestamptz()
  /// Refreshed on every launch, so tokens nobody has used can be swept.
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@index([userId])
}

/// Somebody's public half, so other people can write to them in private.
///
/// Public by design: this is the key anyone needs to seal a message only the
/// holder of the matching secret can open. The secret half never reaches this
/// server, which is the whole point -- what the Message table then carries is
/// ciphertext nobody here has a key for.
///
/// One row per install. Two devices are two keys, and a message sealed for one
/// cannot be opened by the other; that is a real limit, written down rather
/// than papered over.
model MessageKey {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// X25519, raw bytes, base64url. 32 bytes before encoding.
  publicKey String @unique

  /// Which install it belongs to, so a device can replace its own key
  /// without disturbing the others.
  deviceId String

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@unique([userId, deviceId])
  @@index([userId])
}

/// A message's key, sealed again for a device it was not sealed for when it
/// was sent: one that did not exist yet, or whose key was lost.
///
/// A row starts as a request -- the device that cannot open the message asks,
/// and [sealed] is null -- and any device in the conversation that can open
/// the message answers it, by sealing the message's key for the asking
/// device's public key. This server carries the request and the answer and
/// can read neither the message nor its key: what it learns is that a device
/// asked and another answered.
model MessageKeyShare {
  id        String  @id @default(uuid()) @db.Uuid
  messageId String  @db.Uuid
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  /// The account of the device that asked, so it is handed only its own.
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The asking device's public key, as it published it.
  publicKey String

  /// `<answering device's public key>.<nonce>.<sealed key>.<mac>`, all
  /// base64url. Null while the request waits for an answer.
  sealed String?

  createdAt  DateTime  @default(now()) @db.Timestamptz()
  answeredAt DateTime? @db.Timestamptz()

  @@unique([messageId, publicKey])
  @@index([userId])
}

/// What somebody told the team from inside the app: something broken, an
/// idea, or an error report with the app's log attached.
///
/// Private. It used to be filed as an issue on the public repository, which
/// needed a GitHub token on the server, published whatever people wrote --
/// account details pasted into a bug report included -- and left the team no
/// way to answer anybody privately. Here it is read by the team and nobody
/// else, and it goes with the account when the account is deleted.
model Feedback {
  id     String @id @default(uuid()) @db.Uuid
  /// What the sender is told to quote: "report #12".
  number Int    @unique @default(autoincrement())

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind  FeedbackType
  title String
  body  String       @db.Text

  /// The app's own log, when an error report chose to attach it.
  log String? @db.Text

  appVersion String?
  platform   String?

  createdAt DateTime @default(now()) @db.Timestamptz()

  @@index([createdAt(sort: Desc)])
  @@index([userId])
}

enum FeedbackType {
  BUG
  IDEA
  /// Somebody asking for help, from Contact support.
  QUESTION
  /// An error report from About, usually with the log.
  REPORT
}

// ==========================================
// 21. MEDIA JOBS
// ==========================================
/// One clip waiting to be re-encoded, or the record of one that was.
///
/// Re-encoding a 4K clip is tens of seconds of ffmpeg, and it used to happen
/// inside the upload request -- so the person who recorded it watched a
/// spinner for the whole of it. The upload now stores the original and
/// answers immediately, and this row is what remembers that better bytes are
/// still owed.
///
/// A row rather than a promise in memory: a deploy in the middle of an encode
/// would otherwise drop the work with nothing anywhere saying it had been
/// dropped, and the clip would keep its upload bitrate forever.
model MediaJob {
  id String @id @default(uuid()) @db.Uuid

  /// Where the original was stored, which is also where the re-encode is
  /// written back. The URL never changes, so nothing that already links to
  /// this clip needs updating -- only the bytes behind it get smaller.
  path String @unique

  /// Who uploaded it. For working out whose clip is stuck, not for access.
  userId String @db.Uuid

  status MediaJobStatus @default(PENDING)

  /// How many times this has been picked up. A job that keeps failing is
  /// given up on rather than retried forever.
  attempts Int @default(0)

  /// Why the last attempt failed, kept so a failure can be read rather than
  /// guessed at. The clip still plays either way: what is lost is the
  /// smaller file, not the upload.
  lastError String?

  /// Set when a worker takes the job. A process killed mid-encode leaves this
  /// stale, which is how the job is found again and retried.
  claimedAt DateTime? @db.Timestamptz()

  /// What the original weighed, and what it weighs now. Both kept so the
  /// saving is a measurement rather than a claim.
  bytesIn  Int
  bytesOut Int?

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@index([status, createdAt])
}

enum MediaJobStatus {
  PENDING
  RUNNING
  DONE
  /// Given up on after [MediaQueue.maxAttempts]. The original is still
  /// stored and still plays.
  FAILED
  /// ffprobe says this clip does not need re-encoding after all. Recorded
  /// rather than deleted, so "nothing happened" and "nothing was needed" are
  /// different answers.
  SKIPPED
}

/// One person's reaction to one message: a single emoji.
///
/// One per person per message, keyed that way, so reacting again replaces
/// the reaction rather than stacking a second -- the way every messaging app
/// people know behaves. Stored readable, unlike the message it is attached
/// to: a deliberate trade, written down in docs/E2EE.md.
model MessageReaction {
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  emoji     String
  createdAt DateTime @default(now()) @db.Timestamptz()

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([messageId, userId])
  @@index([userId])
}

/// One component's self-checks on one day, counted rather than kept one by
/// one. The service checks itself every few minutes while it is running; a
/// day's uptime is the share of those checks that passed. A day with no row
/// had no checks -- the service was asleep or down, and could not say which
/// -- and is shown as "no data", never as up.
model ServiceDay {
  day       DateTime @db.Date
  component String
  checks    Int      @default(0)
  failures  Int      @default(0)

  @@id([day, component])
}

/// A stretch of time one component was failing its checks: opened by the
/// first failure, closed by the first pass after it.
model ServiceIncident {
  id        String    @id @default(uuid()) @db.Uuid
  component String
  startedAt DateTime  @db.Timestamptz()
  endedAt   DateTime? @db.Timestamptz()

  /// What the failing check said, when it said anything.
  detail String?

  @@index([startedAt])
  @@index([component, endedAt])
}
