# Kyron API — environment template.
# Copy to `.env` and fill in real values. NEVER commit a filled-in copy:
# the root .gitignore now excludes every *.env file except *.example.

# ── Core ──────────────────────────────────────────────────────────────
# Local default. Render sets PORT on the service itself; main.ts reads this
# variable and only falls back to 3000 if it is unset.
PORT=3000
LOG_LEVEL=debug
# Comma-separated allow-list of browser origins. Unset in production, the
# API allows only kyron.spidroid.com and kyron-web.onrender.com
# (src/config/rate-limit.ts, corsOrigins). It reflects any origin only when
# NODE_ENV is not production, for local development.
CORS_ORIGIN=https://kyron.spidroid.com
# How many proxies in front of the API to trust for the caller's address
# (X-Forwarded-For), 0-5. Render puts one in front: set 1 there. 0 (the
# default) trusts none, so the rate limiter sees the proxy's address.
TRUST_PROXY_HOPS=1

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
# Used by docker-compose.yml for the local Postgres container
POSTGRES_USER=kyron
POSTGRES_PASSWORD=
POSTGRES_DB=kyron

# ── Auth ──────────────────────────────────────────────────────────────
# Supabase is the only identity provider; the API's own sign-in, and the
# JWT_* and SENDGRID_* settings it read, are gone. SUPABASE_URL (below) and,
# for projects still on a shared secret, SUPABASE_JWT_SECRET are what verify
# a token.
SUPABASE_JWT_SECRET=

# ── Redis ─────────────────────────────────────────────────────────────
# Read by nothing today. Kept because the moment there is more than one
# instance, three things need a store outside the process: the rate limiter
# (its counters are per process, so two instances allow twice the limit), the
# realtime socket registry, and any background queue. See docs/OBSERVABILITY.md.
# Two more live in memory and would move with them: FeedbackService.recent
# (how often an account has filed feedback) and IdentityService.pending (the
# verification sessions under way). Both reset on every deploy and are not
# shared between instances.
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Supabase ──────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Server-side only — bypasses RLS. Never ship this to the Flutter client.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_NAME=media
SUPABASE_AVATAR_FOLDER=avatars
SUPABASE_COVER_FOLDER=covers

# ── Rate limiting ─────────────────────────────────────────────────────
# Per account and per minute, falling back to per address for callers with no
# token -- one bucket per address means a mobile carrier's NAT shares a single
# limit between thousands of phones. Counted in memory, so per instance too;
# see the Redis note above.
#
# Must be a whole number. The API refuses to start on anything else rather
# than pick one for you: this value used to be silently discarded, and every
# deployment that set it ran at 1000 a minute regardless. See
# api/src/config/rate-limit.ts.
RATE_LIMIT_MAX=100

# kyron-links, the server that renders shared links for people without the app,
# sends this in X-Kyron-Pages-Key and gets a bucket of its own on /public/*
# (3000 a minute) instead of sharing one address's 100 with every visitor.
# Set the same value on kyron-links. At least 32 characters; unset, kyron-links is
# limited like anybody else. Generate with: openssl rand -hex 32
PUBLIC_PAGES_KEY=

# ── Observability ─────────────────────────────────────────────────────
# Turns on GET /metrics, which is shut and answers 404 without it. Give the
# scraper the same value as a Bearer token. Generate with:
#   openssl rand -hex 32
METRICS_TOKEN=

# ── Feedback ──────────────────────────────────────────────────────────
# Nothing to set. "Send Feedback" and "Send error report" in the app are kept
# in the Feedback table, privately, for the team to read (Supabase -> Table
# editor -> Feedback). They used to be filed as public GitHub issues, which
# needed GITHUB_ISSUE_REPO and GITHUB_ISSUE_TOKEN; neither is read any more.
