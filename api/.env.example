# Kyron API — environment template.
# Copy to `.env` and fill in real values. NEVER commit a filled-in copy:
# the root .gitignore now excludes every *.env file except *.example.

# ── Core ──────────────────────────────────────────────────────────────
PORT=3000
LOG_LEVEL=debug
# Comma-separated allow-list of browser origins. Leave UNSET only for local
# dev: main.ts falls back to reflecting any origin, which combined with
# `credentials: true` lets any website make authenticated cross-origin calls.
CORS_ORIGIN=https://kyron.spidroid.com

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
# Used by docker-compose.yml for the local Postgres container
POSTGRES_USER=kyron
POSTGRES_PASSWORD=
POSTGRES_DB=kyron

# ── Auth ──────────────────────────────────────────────────────────────
# REQUIRED. The API refuses to start without it (see src/config/jwt-secret.ts).
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES=15m
JWT_EXPIRES_SECONDS=900
JWT_REFRESH_EXPIRES=7d
REFRESH_TOKEN_EXPIRES_DAYS=7

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Supabase ──────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Server-side only — bypasses RLS. Never ship this to the Flutter client.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_NAME=media
SUPABASE_AVATAR_FOLDER=avatars
SUPABASE_COVER_FOLDER=covers

# ── Email ─────────────────────────────────────────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@kyron.so
FRONTEND_URL=https://kyron.spidroid.com

# ── Rate limiting ─────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
