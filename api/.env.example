# Kyron API — environment template.
# Copy to `.env` and fill in real values. NEVER commit a filled-in copy:
# the root .gitignore now excludes every *.env file except *.example.

# ── Core ──────────────────────────────────────────────────────────────
# Local default. Render sets PORT on the service itself; main.ts reads this
# variable and only falls back to 3000 if it is unset.
PORT=3000
LOG_LEVEL=debug
# Comma-separated allow-list of browser origins. Unset in production, the
# API allows none: the web app is withdrawn, and the Android and Windows apps
# send no Origin (src/config/rate-limit.ts, corsOrigins). It reflects any
# origin only when NODE_ENV is not production, for local development.
# CORS_ORIGIN=
# How many proxies in front of the API to trust for the caller's address
# (X-Forwarded-For), 0-5. Render puts one in front: set 1 there. 0 (the
# default) trusts none, so the rate limiter sees the proxy's address.
TRUST_PROXY_HOPS=1

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
# Used by docker-compose.yml for the local Postgres container
POSTGRES_USER=kyron
POSTGRES_PASSWORD=
POSTGRES_DB=kyron

# ── Auth ──────────────────────────────────────────────────────────────
# Supabase is the only identity provider and handles authentication mail.
# SUPABASE_URL (below) and,
# for projects still on a shared secret, SUPABASE_JWT_SECRET are what verify
# a token.
SUPABASE_JWT_SECRET=

# ── Redis ─────────────────────────────────────────────────────────────
# Read by nothing today. Kept because the moment there is more than one
# instance, three things need a store outside the process: the rate limiter
# (its counters are per process, so two instances allow twice the limit), the
# realtime socket registry, and any background queue. See docs/OBSERVABILITY.md.
# Two more live in memory and would move with them: FeedbackService.recent
# (how often an account has filed feedback) and IdentityService.pending (the
# verification sessions under way). Both reset on every deploy and are not
# shared between instances.
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Supabase ──────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Server-side only — bypasses RLS. Never ship this to the Flutter client.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_NAME=media
SUPABASE_AVATAR_FOLDER=avatars
SUPABASE_COVER_FOLDER=covers

# ── Rate limiting ─────────────────────────────────────────────────────
# Per account and per minute, falling back to per address for callers with no
# token -- one bucket per address means a mobile carrier's NAT shares a single
# limit between thousands of phones. Counted in memory, so per instance too;
# see the Redis note above.
#
# Must be a whole number. The API refuses to start on anything else rather
# than pick one for you: this value used to be silently discarded, and every
# deployment that set it ran at 1000 a minute regardless. See
# api/src/config/rate-limit.ts.
RATE_LIMIT_MAX=100

# kyron-links, the server that renders shared links for people without the app,
# sends this in X-Kyron-Pages-Key and gets a bucket of its own on /public/*
# (3000 a minute) instead of sharing one address's 100 with every visitor.
# Set the same value on kyron-links. At least 32 characters; unset, kyron-links is
# limited like anybody else. Generate with: openssl rand -hex 32
PUBLIC_PAGES_KEY=

# ── Staff ─────────────────────────────────────────────────────────────
# When true, moderation and verification refuse a staff session that has not
# passed a second factor (an authenticator code) with 403
# STAFF_SECOND_FACTOR_REQUIRED. Turn it on only after every staff account has
# enrolled an authenticator in the app (Settings > Two-step sign-in);
# before that it locks staff out of moderation.
STAFF_REQUIRE_SECOND_FACTOR=false

# ── Google Play coin purchases ─────────────────────────────────────────
# Keep disabled until Play Console products, service-account permissions,
# token encryption key, RTDN and refund/void reconciliation are configured.
GOOGLE_PLAY_PURCHASES_ENABLED=false
GOOGLE_PLAY_PACKAGE_NAME=so.kyron.app
# JSON service-account key for the Android Publisher API. Never commit a value.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Generate a dedicated 32-byte AES-256-GCM key: openssl rand -base64 32
GOOGLE_PLAY_TOKEN_ENCRYPTION_KEY=
# Dedicated Pub/Sub push identity, separate from the Publisher API account.
# Keep disabled until reconciliation and operational review are ready.
GOOGLE_PLAY_RTDN_ENABLED=false
# Evidence-only reconciliation; independent of purchase crediting.
GOOGLE_PLAY_RECONCILIATION_ENABLED=false
# Scheduled evidence verification, independent of receipt-only recovery.
GOOGLE_PLAY_AUTOMATED_RECONCILIATION_ENABLED=false
# Receipt-only scheduled recovery. Independent of purchase and RTDN flags.
GOOGLE_PLAY_RECOVERY_ENABLED=false
# Dedicated random secret shared only by the API and recovery workflow.
GOOGLE_PLAY_RECOVERY_CRON_KEY=
GOOGLE_PLAY_RTDN_AUDIENCE=
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_SUBJECT=
# Full subscription name: projects/<project>/subscriptions/<name>
GOOGLE_PLAY_RTDN_SUBSCRIPTION=
# Server-authoritative product mapping; use only IDs and coin quantities
# approved in Play Console and product policy. No client-supplied amount is read.
# GOOGLE_PLAY_COIN_PRODUCTS=[{"productId":"<Play Console product ID>","coins":<approved coin quantity>}]

# ── Creator withdrawals and payout submissions ────────────────────────
# Withdrawal requests stay disabled until the withdrawal minimum is approved
# and configured. Do not invent a minimum for this environment.
CREATOR_WITHDRAWALS_ENABLED=false
# CREATOR_WITHDRAWAL_MIN_COINS=
#
# Bank transfer submission has its own independent kill switch and must remain
# disabled until payout operations, provider configuration and policy approval
# are complete.
CREATOR_PAYOUT_SUBMISSIONS_ENABLED=false

# ── Observability ─────────────────────────────────────────────────────
# Turns on GET /metrics, which is shut and answers 404 without it. Give the
# scraper the same value as a Bearer token. Generate with:
#   openssl rand -hex 32
METRICS_TOKEN=

# ── Feedback ──────────────────────────────────────────────────────────
# Nothing to set. "Send Feedback" and "Send error report" in the app are kept
# in the Feedback table, privately, for the team to read (Supabase -> Table
# editor -> Feedback). They used to be filed as public GitHub issues, which
# needed GITHUB_ISSUE_REPO and GITHUB_ISSUE_TOKEN; neither is read any more.
