# Kyron API — environment template.
# Copy to `.env` and fill in real values. NEVER commit a filled-in copy:
# the root .gitignore now excludes every *.env file except *.example.

# ── Core ──────────────────────────────────────────────────────────────
# Local default. Fly sets PORT=8080 in api/fly.toml to match internal_port
# there; main.ts reads this variable and only falls back to 3000 if it is unset.
PORT=3000
LOG_LEVEL=debug
# Comma-separated allow-list of browser origins. Leave UNSET only for local
# dev: main.ts falls back to reflecting any origin, which combined with
# `credentials: true` lets any website make authenticated cross-origin calls.
CORS_ORIGIN=https://kyron.spidroid.com

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
# Used by docker-compose.yml for the local Postgres container
POSTGRES_USER=kyron
POSTGRES_PASSWORD=
POSTGRES_DB=kyron

# ── Auth ──────────────────────────────────────────────────────────────
# REQUIRED. The API refuses to start without it (see src/config/jwt-secret.ts).
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES=15m
JWT_EXPIRES_SECONDS=900
JWT_REFRESH_EXPIRES=7d
REFRESH_TOKEN_EXPIRES_DAYS=7

# ── Redis ─────────────────────────────────────────────────────────────
# Read by nothing today. Kept because the moment there is more than one
# instance, three things need a store outside the process: the rate limiter
# (its counters are per process, so two instances allow twice the limit), the
# realtime socket registry, and any background queue. See docs/OBSERVABILITY.md.
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Supabase ──────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Server-side only — bypasses RLS. Never ship this to the Flutter client.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_NAME=media
SUPABASE_AVATAR_FOLDER=avatars
SUPABASE_COVER_FOLDER=covers

# ── Email ─────────────────────────────────────────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@kyron.so
FRONTEND_URL=https://kyron.spidroid.com

# ── Rate limiting ─────────────────────────────────────────────────────
# Per instance and per minute, counted in memory. See the Redis note above.
RATE_LIMIT_MAX=100

# ── Observability ─────────────────────────────────────────────────────
# Turns on GET /metrics, which is shut and answers 404 without it. Give the
# scraper the same value as a Bearer token. Generate with:
#   openssl rand -hex 32
METRICS_TOKEN=
